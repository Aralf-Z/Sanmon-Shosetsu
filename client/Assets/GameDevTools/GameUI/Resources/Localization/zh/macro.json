{
  "entries": [
    { "key": "macro.syntax.command.title", "value": "命令与参数" },
    { "key": "macro.syntax.command.description", "value": "每行一个已注册命令调用, 参数按声明顺序填写. 尾部可选参数可省略. 宏不能调用其他宏; 普通调用不会等待异步结果." },
    { "key": "macro.syntax.string.title", "value": "字符串与转义" },
    { "key": "macro.syntax.string.description", "value": "字符串使用引号. 反斜线用于转义引号, 反斜线及换行等字符. 字符串内部的 // 不会开始注释." },
    { "key": "macro.syntax.string.example", "value": "SomeCommand(\"文字 // 仍属于字符串\")" },
    { "key": "macro.syntax.comment.title", "value": "// 注释" },
    { "key": "macro.syntax.comment.description", "value": "// 可以独占一行, 也可以跟在命令后面. 注释不执行. 行尾注释与同一行语句同色; 独立注释行使用正文颜色." },
    { "key": "macro.syntax.comment.example", "value": "// 独立注释\nWaitFor() // 等待下一帧" },
    { "key": "macro.syntax.repeat.description", "value": "重复执行到 EndRepeat() 之间的命令. 次数必须为 {Config_MIN_MACRO_REPEAT_COUNT} 到 {Config_MAX_MACRO_REPEAT_COUNT} 的整数文字值. 不支持嵌套; 可以依次编写多个独立循环. 没有 WaitFor 时连续执行, 不自动分帧." },
    { "key": "macro.syntax.endRepeat.description", "value": "结束最近一个 Repeat 循环. 不接受参数, 必须和 Repeat 配对. 与 Repeat 共用同一组语法颜色." },
    { "key": "macro.syntax.waitFrame.description", "value": "等待下一帧再执行下一行. 循环内每次经过这里都会等待一帧." },
    { "key": "macro.syntax.waitSeconds.title", "value": "WaitFor(秒数)" },
    { "key": "macro.syntax.waitSeconds.description", "value": "等待有限的非负秒数, 不受 timeScale 影响. 只接受秒数字面量或命令调用." },
    { "key": "macro.syntax.waitCommand.title", "value": "WaitFor(命令调用)" },
    { "key": "macro.syntax.waitCommand.description", "value": "调用命令一次并等待完成. 支持 Task, UniTask 及泛型形式和 IEnumerator. 同步方法返回即完成; UniTaskVoid 不能等待. 停止宏不强行终止业务方法." },
    { "key": "macro.color.lightBlue", "value": "淡蓝" },
    { "key": "macro.color.lightGreen", "value": "淡绿" },
    { "key": "macro.color.lightYellow", "value": "淡黄" },
    { "key": "macro.color.orange", "value": "浅橙" },
    { "key": "macro.color.purple", "value": "淡紫" },
    { "key": "macro.color.white", "value": "正文白" },
    { "key": "macro.syntax.command.example", "value": "GetCoin(0, 100)" },
    { "key": "macro.syntax.repeat.title", "value": "Repeat(n)" },
    { "key": "macro.syntax.repeat.example", "value": "Repeat({Config_MIN_MACRO_REPEAT_COUNT})\nGetCoin(0, 100)\nWaitFor(0.2)\nEndRepeat()" },
    { "key": "macro.syntax.endRepeat.title", "value": "EndRepeat()" },
    { "key": "macro.syntax.endRepeat.example", "value": "Repeat({Config_MIN_MACRO_REPEAT_COUNT})\nWaitFor()\nEndRepeat()" },
    { "key": "macro.syntax.waitFrame.title", "value": "WaitFor()" },
    { "key": "macro.syntax.waitFrame.example", "value": "WaitFor()" },
    { "key": "macro.syntax.waitSeconds.example", "value": "WaitFor(0.2)" },
    { "key": "macro.syntax.waitCommand.example", "value": "WaitFor(SomeAsyncCommand())" }
  ]
}
