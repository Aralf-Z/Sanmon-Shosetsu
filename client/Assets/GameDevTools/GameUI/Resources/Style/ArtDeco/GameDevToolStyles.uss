/* StyleKit art-deco: adapted to UI Toolkit, with the user-selected Schema font. */
:root {
 --dev-background: #1a1a2e; --dev-surface: #25253b; --dev-input: #151525;
 --dev-border: #a68a39; --dev-text: #f5f5dc; --dev-muted: #d0c39c; --dev-accent: #4b4029;
 --theme-accent: #d4af37; --theme-screen: #17172a;
 color: var(--dev-text);
}
.dev-window { border-width: 1px; border-radius: 0px; --dev-opacity-background: var(--dev-background); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: var(--dev-border); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--dev-border); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--dev-border); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--dev-border); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.header { --dev-opacity-background: var(--dev-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-bottom-width: 1px; --dev-opacity-border-bottom: var(--theme-accent); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); }
.title { color: var(--theme-accent); -unity-font-style: bold; }
.footer { --dev-opacity-background: var(--dev-input); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--dev-muted); border-top-width: 1px; --dev-opacity-border-top: var(--dev-border); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); }
.section-title, .settings-section-title, .help-feature-title { color: var(--dev-text); }
.muted, .help-area-title, .help-page-info, .settings-section-hint { color: var(--dev-muted); }
Button { --dev-opacity-background: var(--dev-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--dev-text); border-width: 1px; --dev-opacity-border-top: var(--dev-border); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--dev-border); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--dev-border); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--dev-border); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 0px; }
