.floating-tool { border-width: 2px; --dev-opacity-border-top: #d4af37; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #d4af37; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #d4af37; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #d4af37; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); --dev-opacity-background: #1a1a2e; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.floating-badge-frame { --dev-opacity-border-top: #a68a39; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #a68a39; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #a68a39; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #a68a39; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); left: 4px; top: 4px; right: 4px; bottom: 4px; }
.floating-badge-mark-a { left: 25px; top: 1px; bottom: auto; width: 20px; height: 3px; --dev-opacity-background: #d4af37; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.floating-badge-mark-b { left: 25px; bottom: 1px; width: 20px; height: 3px; --dev-opacity-background: #d4af37; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
