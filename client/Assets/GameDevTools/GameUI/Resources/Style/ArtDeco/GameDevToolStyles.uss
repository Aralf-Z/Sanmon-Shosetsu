.floating-settings-button { font-size: 14px; }
.floating-log-preview { border-width: 2px; --dev-opacity-border-top: #a68a39; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #a68a39; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #a68a39; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #a68a39; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); --dev-opacity-border-left: #d4af37; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); padding: 7px; }
