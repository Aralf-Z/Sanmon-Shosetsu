Button:active, Button.selected { --dev-opacity-background: var(--dev-accent); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--dev-text); --dev-opacity-border-top: var(--theme-accent); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--theme-accent); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--theme-accent); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--theme-accent); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
Button:focus { --dev-opacity-border-top: var(--theme-accent); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--theme-accent); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--theme-accent); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--theme-accent); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
