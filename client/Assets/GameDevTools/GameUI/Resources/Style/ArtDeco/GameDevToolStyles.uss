.unity-scroller .unity-base-slider__input, .dev-horizontal-slider > .unity-base-slider__input { --dev-opacity-background: transparent; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-width: 0; padding: 0; }
