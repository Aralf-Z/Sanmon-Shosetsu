.header { border-bottom-width: 3px; --dev-opacity-border-bottom: #a68a39; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); padding-top: 12px; padding-bottom: 12px; }
.title { color: #d4af37; font-size: 20px; }
