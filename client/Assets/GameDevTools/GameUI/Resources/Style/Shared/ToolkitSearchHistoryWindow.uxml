<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:dev="GameConsole.UI" editor-extension-mode="False">
    <ui:Style src="GameDevToolLayout.uss" />
    <ui:Style src="ToolkitControls.uss" />
    <ui:VisualElement name="searchHistoryDialog" class="search-history-dialog">
        <ui:VisualElement class="theme-shadow" picking-mode="Ignore" />
        <ui:VisualElement class="theme-dialog-surface">
            <ui:VisualElement name="searchHistoryHeader" class="toolkit-dialog-header">
                <ui:VisualElement class="toolkit-dialog-heading" picking-mode="Ignore">
                    <ui:Label name="historyWindowTitle" class="section-title toolkit-dialog-title" picking-mode="Ignore" />
                </ui:VisualElement>
                <dev:ToolkitHeaderPattern class="window-header-pattern" picking-mode="Ignore" />
                <ui:Button name="closeSearchHistoryWindow" text="@loc:icon.close" class="window-control-button" />
            </ui:VisualElement>
            <ui:VisualElement class="search-history-window-content">
                <ui:Label name="searchHistoryWindowCount" class="muted" />
                <ui:Label name="historyWindowHint" class="settings-section-hint" />
                <ui:ScrollView name="searchHistoryWindowScroll" class="search-history-window-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                    <ui:VisualElement name="searchHistoryEntries" class="search-history-records" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
