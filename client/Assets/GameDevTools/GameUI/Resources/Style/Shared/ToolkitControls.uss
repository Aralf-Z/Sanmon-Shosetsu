.console-log-body, .console-log-type, .suggestion-list .list-item-text {
    color: #e2e8f0;
}

.console-stack-text {
    color: #e2e8f0;
}

.cheat-latest-log {
    color: #e2e8f0;
}

.macro-native-text {
    color: transparent;
}

.macro-diagnostics.macro-error {
    color: #f27a5f;
}

.floating-log-line {
    color: #e2e8f0;
}

.macro-source-scroll {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
}

.macro-source-scroll > .unity-scroll-view__content-and-vertical-scroll-container {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.macro-source-scroll .macro-source {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    min-width: 0;
    min-height: 0;
    margin: 0;
}

.macro-source-scroll .macro-source > .unity-base-field__input {
    flex-grow: 1;
    flex-basis: auto;
    min-width: 0;
    min-height: 0;
    -unity-text-align: upper-left;
    white-space: nowrap;
}

.macro-source .macro-inner-scroll {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
}

.macro-source .macro-inner-scroll > .unity-scroll-view__content-and-vertical-scroll-container {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.macro-initialization-error {
    white-space: normal;
    flex-shrink: 0;
    margin: 12px;
}

#windowHeader {
    background-image: none;
}

.dev-desktop .toolkit-dialog-header {
    background-image: none;
}

.dev-desktop .toolkit-dialog-heading {
    flex-grow: 0;
    flex-basis: auto;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 8px;
    padding-right: 4px;
    overflow: hidden;
}

.dev-desktop .toolkit-dialog-title {
    margin: 0;
    white-space: nowrap;
    overflow: visible;
    text-overflow: clip;
}

.toolkit-dialog-header > .window-header-pattern {
    flex-shrink: 1;
}

.help-pagination-status {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: var(--dev-muted);
    -unity-text-align: middle-center;
}

.help-pager-loading > .unified-page-group {
    visibility: hidden;
}

.help-pager-loading > .help-pagination-status {
    display: flex;
}

.help-navigation .help-tree-branch > .unity-foldout__toggle, .help-navigation Button.help-tree-entry {
    --dev-opacity-background: transparent;
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    background-image: none;
    border-width: 0;
    border-radius: 6px;
    color: var(--dev-text);
}

.help-navigation .help-tree-branch > .unity-foldout__toggle {
    padding: 6px 4px;
}

.help-navigation .help-tree-branch > .unity-foldout__toggle .unity-toggle__input {
    --dev-opacity-background: transparent;
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    border-width: 0;
}

.help-navigation Button.help-tree-entry {
    padding: 4px 8px;
}

.help-navigation .help-tree-branch > .unity-foldout__toggle:hover, .help-navigation .help-tree-branch > .unity-foldout__toggle:focus, .help-navigation Button.help-tree-entry:hover, .help-navigation Button.help-tree-entry:focus {
    --dev-opacity-background: var(--help-hover-background);
}

.help-navigation Button.help-tree-entry.selected {
    --dev-opacity-background: var(--help-selected-background);
    color: var(--help-selected-text);
    -unity-font-style: bold;
}

.floating-log-preview {
    padding-top: 10px;
    padding-bottom: 10px;
}

.floating-settings .setting-row.unity-toggle > .unity-toggle__input {
    --dev-opacity-background: transparent;
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    border-width: 0;
}

.window-header-pattern {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 30px;
    align-self: stretch;
    --header-pattern-fade: 32;
    --dev-opacity-image-tint: #ffffff;
    --dev-opacity-image-tint-set: 1;
    -unity-background-image-tint-color: var(--dev-opacity-image-tint);
}

/* 紧凑控件的几何在风格之后应用, 通用 Button padding 不参与图标排版. */
.dev-desktop Button.toolkit-icon-control, .dev-desktop Toggle.toolkit-icon-control {
    width: 32px;
    min-width: 32px;
    max-width: 32px;
    height: 30px;
    min-height: 30px;
    max-height: 30px;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-width: 1px;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.dev-desktop Toggle.toolkit-icon-control > .unity-toggle__input {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 2px;
    bottom: 2px;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    min-width: 0;
    min-height: 0;
    padding: 0;
    margin: 0;
    border-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
    justify-content: center;
}

.dev-desktop Toggle.toolkit-icon-control .unity-toggle__text, .dev-desktop .toolkit-icon-indicator {
    width: 24px;
    min-width: 24px;
    max-width: 24px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    border-width: 0;
    flex-shrink: 0;
}

.dev-desktop Toggle.toolkit-icon-control .unity-toggle__text {
    margin: 0;
}

.dev-desktop .console-columns {
    padding-right: 34px;
}

.dev-desktop .console-details-overlay {
    right: 34px;
}

.dev-desktop .tag-filter-toolbar {
    align-items: flex-end;
    min-width: 0;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-bottom: 8px;
    border-top-width: 1px;
    --dev-opacity-border-top: var(--dev-border);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    border-bottom-width: 1px;
    --dev-opacity-border-bottom: var(--dev-border);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
}

.dev-desktop .toolkit-search-field > .unity-base-text-field__input {
    padding-left: 8px;
}

.dev-desktop .unified-pager {
    position: relative;
    flex-shrink: 0;
    min-width: 0;
    height: 30px;
    margin: 6px 0 0;
    padding: 0;
    border-width: 0;
}

.dev-desktop .unified-page-group {
    position: absolute;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
}

.dev-desktop Button.unified-page-button {
    position: absolute;
    width: 32px;
    min-width: 32px;
    max-width: 32px;
    height: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 2px;
    margin: 0;
    border-width: 1px;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: hidden;
    -unity-text-align: middle-center;
}

.dev-desktop .unified-page-info {
    position: absolute;
    margin: 0;
    padding: 0;
    border-width: 0;
    min-width: 0;
    font-size: 12px;
    color: var(--dev-muted);
    white-space: nowrap;
    text-overflow: clip;
    -unity-text-align: middle-center;
}

.dev-desktop TextField.unified-page-input {
    position: absolute;
    min-width: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    font-size: 16px;
    align-items: stretch;
}

.dev-desktop TextField.unified-page-input > .unity-base-field__input {
    min-width: 0;
    min-height: 0;
    height: 100%;
    align-items: stretch;
    margin: 0;
    padding: 0 4px;
    border-width: 1px;
    -unity-text-align: middle-center;
}

.dev-desktop .unified-page-input .unity-text-element {
    flex-grow: 1;
    align-self: stretch;
    height: 100%;
    min-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.dev-desktop .tag-overflow-pager.unified-pager {
    margin: 0;
    padding: 4px;
    border-top-width: 1px;
    --dev-opacity-border-top: var(--dev-border);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
}

.context-menu-root .unity-base-dropdown__container-inner,
.context-menu-root .unity-scroll-view__content-and-vertical-scroll-container,
.context-menu-root .unity-scroll-view__content-viewport {
    flex-grow: 0;
    flex-shrink: 0;
    max-height: none;
}

.context-menu-root .unity-scroller {
    display: none;
}

.context-menu-root .unity-base-dropdown__item {
    flex-shrink: 0;
}
