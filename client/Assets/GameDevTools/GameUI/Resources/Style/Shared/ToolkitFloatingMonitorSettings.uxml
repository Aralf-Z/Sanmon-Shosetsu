<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="floating-performance-options">
        <ui:VisualElement class="floating-performance-option-row">
            <ui:Toggle name="floatingRealtimeFps" label="@loc:floating.frameMonitor.realtime" class="floating-performance-option-first" />
            <ui:Toggle name="floatingAverageFps" label="@loc:floating.frameMonitor.average" />
        </ui:VisualElement>
        <ui:VisualElement class="floating-performance-option-row">
            <ui:Toggle name="floatingLowFps" label="@loc:floating.frameMonitor.low" class="floating-performance-option-first" />
            <ui:Toggle name="floatingFrameTimeGraphToggle" label="@loc:floating.frameMonitor.graph" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:SliderInt name="floatingFrameTimeBaseline" label="@loc:floating.frameMonitor.baseline" tooltip="@loc:floating.frameMonitor.baseline.tooltip" class="setting-row floating-setting-slider dev-horizontal-slider" />
    <ui:SliderInt name="floatingMonitorBackgroundOpacity" label="@loc:floating.frameMonitor.backgroundOpacity" class="setting-row floating-setting-slider dev-horizontal-slider" />
</ui:UXML>
