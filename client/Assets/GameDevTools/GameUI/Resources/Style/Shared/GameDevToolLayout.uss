.floating-log-lines > TemplateContainer { height: auto; min-height: 20px; flex-shrink: 0; margin: 0; padding: 0; }
.floating-log-line { height: auto; min-height: 20px; flex-shrink: 0; margin: 0; padding: 0; font-size: 12px; white-space: nowrap; overflow: hidden; -unity-text-align: middle-left; }
.floating-settings { position: absolute; left: 0; top: 0; width: 320px; padding: 10px; --dev-opacity-background: var(--dev-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-width: 1px; --dev-opacity-border-top: var(--dev-border); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--dev-border); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--dev-border); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--dev-border); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 6px; transform-origin: 0% 0%; }
.floating-settings > TemplateContainer, .floating-settings-content, .floating-settings-form { flex-shrink: 0; }
.floating-settings-hint { white-space: normal; margin-bottom: 8px; }
.floating-settings .setting-row { flex-direction: column; align-items: stretch; margin: 4px 0; }
.floating-settings .setting-row .unity-base-field__label { min-width: 0; margin-bottom: 4px; }
.floating-setting-slider { flex-direction: column; align-items: stretch; flex-shrink: 0; }
.floating-setting-slider > .unity-base-field__label { min-width: 0; margin-bottom: 4px; }
.floating-setting-slider > .unity-base-slider__input { flex-grow: 0; }
.dev-horizontal-slider > .unity-base-slider__input { align-self: stretch; flex-shrink: 0; height: 24px; min-height: 24px; min-width: 0; padding: 0; border-width: 0; --dev-opacity-background: transparent; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.dev-horizontal-slider .unity-base-slider__drag-container { height: 24px; min-height: 24px; align-self: stretch; flex-grow: 1; }
.dev-horizontal-slider .unity-base-slider__tracker { left: 8px; right: 8px; top: 10px; bottom: auto; height: 4px; --dev-opacity-background: #60748c; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-radius: 2px; }
.dev-horizontal-slider .unity-base-slider__dragger { top: 4px; width: 16px; height: 16px; --dev-opacity-background: #69a9e0; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-radius: 8px; }
.dev-horizontal-slider:disabled .unity-base-slider__tracker { --dev-opacity-background: #445267; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.dev-horizontal-slider:disabled .unity-base-slider__dragger { --dev-opacity-background: #697589; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }

/* Shared structure keeps live theme changes independent of control instances. */
.theme-shadow, .theme-popup-outline { display: none; }
.theme-window-surface, .theme-dialog-surface { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; }

/* Same hit area in every theme; ornaments never participate in layout or picking. */
.floating-tool { width: 76px; height: 56px; }
.floating-badge-frame { position: absolute; left: 5px; top: 5px; right: 5px; bottom: 5px; border-width: 1px; --dev-opacity-border-top: #526d88; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #526d88; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #526d88; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #526d88; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 5px; }
.floating-badge-mark-a { position: absolute; left: 0; top: 15px; bottom: 15px; width: 3px; --dev-opacity-background: #75b8ef; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.floating-badge-mark-b { position: absolute; left: 13px; bottom: 9px; width: 18px; height: 2px; --dev-opacity-background: #75b8ef; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.floating-badge-prefix { display: none; position: absolute; left: 10px; top: 18px; color: #75b8ef; font-size: 14px; -unity-font-style: bold; }
.floating-icon { margin-right: 8px; padding-top: 1px; font-size: 14px; }
.floating-settings-button { right: 3px; top: 2px; width: 18px; height: 20px; border-radius: 3px; }
.floating-tool:hover .floating-badge-frame { --dev-opacity-border-top: #b6e1ff; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #b6e1ff; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #b6e1ff; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #b6e1ff; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.floating-log-preview { --floating-log-background: #212731; border-width: 1px; --dev-opacity-border-top: #526d88; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #526d88; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #526d88; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #526d88; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-left-width: 3px; --dev-opacity-border-left: #75b8ef; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }

.options-page .shortcut-picker {
    flex-direction: row;
    align-items: stretch;
    padding: 0;
    border-width: 0;
    --dev-opacity-background: transparent;
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
}
.options-page .shortcut-picker > .ui-style-picker { width: auto; min-width: 0; flex-basis: 0; flex-grow: 2; margin: 0; }
.options-page .shortcut-picker > .shortcut-modifier-picker { flex-grow: 1; margin-right: 8px; }
.options-page #minimizeOnShortcut > .unity-toggle__input {
    --dev-opacity-background: transparent;
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    border-width: 0;
}
