/* StyleKit Retro Vintage: aged paper, letterpress borders and stationary controls. */
:root {
    --rv-sepia: #8b4513;
    --rv-paper: #f5e6d3;
    --rv-surface: #faf0e2;
    --rv-brick: #c94c4c;
    --rv-forest: #2e4a3f;
    --rv-sand: #d4a373;
    --rv-olive: #816904;
    --rv-screen: #1d2b25;
    --dev-background: var(--rv-paper);
    --dev-surface: var(--rv-surface);
    --dev-input: var(--rv-surface);
    --dev-border: var(--rv-sepia);
    --dev-text: #5c2e0a;
    --dev-muted: #765b3c;
    --dev-accent: var(--rv-forest);
    color: var(--dev-text);
}

.dev-window { border-width: 2px; --dev-opacity-border-top: var(--rv-sepia); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-sepia); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-sepia); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-sepia); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 4px; }
.dev-window, .header, .footer, .settings-section, .command-hover-details, .help-dialog, .search-history-dialog, .floating-settings {
    background-image: url("SurfaceTexture.png");
    background-repeat: repeat repeat;
    background-size: 128px 128px;
}
.header { --dev-opacity-background: var(--rv-paper); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-bottom-width: 2px; --dev-opacity-border-bottom: var(--rv-sepia); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); padding-bottom: 9px; }
.title, .section-title, .help-feature-title, .search-history-window-title { color: var(--rv-sepia); -unity-font-style: bold; }
.footer, .footer.muted { color: var(--rv-paper); --dev-opacity-background: var(--rv-forest); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-top-width: 2px; --dev-opacity-border-top: var(--rv-sepia); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); padding-top: 6px; }
.muted, .help-area-title, .help-page-info, .settings-section-hint { color: #765b3c; }

Button { --dev-opacity-background: var(--rv-sepia); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-paper); border-width: 2px; --dev-opacity-border-top: var(--rv-sepia); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-sepia); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-sepia); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-sepia); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 4px; padding: 4px 11px; }
Button:hover { --dev-opacity-background: #6f350f; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-paper); --dev-opacity-border-top: #5c2e0a; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #5c2e0a; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #5c2e0a; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #5c2e0a; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
Button:active { --dev-opacity-background: var(--rv-paper); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-sepia); --dev-opacity-border-top: var(--rv-sepia); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-sepia); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-sepia); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-sepia); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
Button.selected { --dev-opacity-background: var(--rv-forest); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-paper); --dev-opacity-border-top: var(--rv-forest); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-forest); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-forest); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-forest); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
Button:focus { --dev-opacity-border-top: var(--rv-brick); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-brick); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-brick); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-brick); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
Button:disabled { color: #887968; --dev-opacity-background: #dfd2c0; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: #b2a18b; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #b2a18b; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #b2a18b; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #b2a18b; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
Button.help-button { --dev-opacity-background: var(--rv-olive); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-paper); border-width: 2px; padding: 0 2px; }
.side-tab { --dev-opacity-background: var(--rv-paper); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-sepia); border-top-right-radius: 0; border-bottom-right-radius: 0; }
.side-tab.selected { --dev-opacity-background: var(--rv-forest); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-paper); }

.unity-base-field__input { --dev-opacity-background: var(--rv-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--dev-text); border-width: 2px; --dev-opacity-border-top: var(--rv-sepia); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-sepia); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-sepia); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-sepia); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 4px; padding: 5px 7px; }
.unity-base-field__input:focus { --dev-opacity-border-top: #5c2e0a; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #5c2e0a; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #5c2e0a; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #5c2e0a; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.unity-base-text-field__input { --unity-cursor-color: #5c2e0a; --unity-selection-color: rgba(139, 69, 19, .25); }
.unity-toggle__input { --dev-opacity-background: transparent; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-width: 0; padding: 0; }
.unity-toggle__checkmark { --dev-opacity-background: var(--rv-paper); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-width: 2px; --dev-opacity-border-top: var(--rv-sepia); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-sepia); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-sepia); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-sepia); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 3px; }
.unity-toggle:checked .unity-toggle__checkmark { --dev-opacity-background: var(--rv-forest); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: var(--rv-forest); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-forest); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-forest); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-forest); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.unity-scroller .unity-base-slider__input { border-width: 0; padding: 0; --dev-opacity-background: transparent; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.unity-base-slider__tracker { --dev-opacity-background: #dfc8ad; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-radius: 3px; }
.unity-base-slider__dragger { --dev-opacity-background: var(--rv-sepia); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-radius: 3px; }
.unity-base-slider__dragger:hover { --dev-opacity-background: var(--rv-forest); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.command-list .unity-scroller--vertical, .settings-scroll .unity-scroller--vertical, .macro-source-native-scroll .unity-scroller { --dev-opacity-background: #dfc8ad; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-radius: 3px; }
.command-list .unity-scroller--vertical .unity-base-slider__tracker, .settings-scroll .unity-scroller--vertical .unity-base-slider__tracker, .macro-source-native-scroll .unity-base-slider__tracker { --dev-opacity-background: #dfc8ad; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.dev-horizontal-slider > .unity-base-slider__input { border-width: 0; padding: 0; --dev-opacity-background: transparent; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.dev-horizontal-slider .unity-base-slider__tracker { --dev-opacity-background: #b79571; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.dev-horizontal-slider .unity-base-slider__dragger { --dev-opacity-background: var(--rv-sepia); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-radius: 3px; }
.dev-horizontal-slider:disabled .unity-base-slider__tracker { --dev-opacity-background: #b2a18b; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.dev-horizontal-slider:disabled .unity-base-slider__dragger { --dev-opacity-background: #887968; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }

.unity-list-view { --dev-opacity-background: var(--rv-paper); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: var(--rv-sepia); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-sepia); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-sepia); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-sepia); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.unity-collection-view__item:hover { --dev-opacity-background: #e8d5c0; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.unity-collection-view__item--selected { --dev-opacity-background: #dec2a2; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.command-button { --dev-opacity-background: var(--rv-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-sepia); padding: 3px 9px; }
.command-button:hover { --dev-opacity-background: #6f350f; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-paper); }
.command-button:active { --dev-opacity-background: var(--rv-paper); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-sepia); }
.command-button.selected { --dev-opacity-background: var(--rv-forest); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-paper); }
.command-button:disabled { color: #887968; --dev-opacity-background: #dfd2c0; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: #b2a18b; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #b2a18b; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #b2a18b; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #b2a18b; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.fixed-macro-entry { --dev-opacity-background: var(--rv-forest); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-paper); border-width: 2px; --dev-opacity-border-top: var(--rv-sepia); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-sepia); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-sepia); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-sepia); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-left-width: 4px; --dev-opacity-border-left: var(--rv-brick); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 4px; padding: 3px 11px 3px 12px; }
.fixed-macro-entry:hover { --dev-opacity-background: #243c32; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-paper); --dev-opacity-border-top: var(--rv-sepia); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-sepia); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-sepia); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-sepia); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); --dev-opacity-border-left: var(--rv-brick); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.fixed-macro-entry:active, .fixed-macro-entry.selected { --dev-opacity-background: var(--rv-paper); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-forest); --dev-opacity-border-top: var(--rv-forest); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-forest); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-forest); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-forest); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); --dev-opacity-border-left: var(--rv-brick); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.fixed-macro-entry:focus { --dev-opacity-border-top: var(--rv-brick); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-brick); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-brick); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-brick); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.pin-drag-handle, .macro-pin-marker { color: var(--rv-sepia); }
.pin-drag-handle:hover { color: var(--rv-paper); --dev-opacity-background: var(--rv-forest); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.preset-button { --dev-opacity-background: var(--rv-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-sepia); padding: 3px; }
.preset-button:active { --dev-opacity-background: var(--rv-paper); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-sepia); }
.preset-button:disabled { color: #887968; --dev-opacity-background: #dfd2c0; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: #b2a18b; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #b2a18b; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #b2a18b; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #b2a18b; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.preset-name { color: var(--rv-sepia); }
.preset-button:hover .preset-name, .preset-button.selected .preset-name { color: var(--rv-paper); }
.preset-button:active .preset-name { color: var(--rv-sepia); }
Button:disabled .preset-name, .preset-button:disabled .preset-name { color: #887968; }
.macro-grid-button { padding: 0 4px; }
.execute-button, #saveMacro, #runMacro { --dev-opacity-background: var(--rv-forest); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-paper); }
.execute-button:hover, #saveMacro:hover, #runMacro:hover { --dev-opacity-background: #243c32; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-paper); }
#deleteMacro, #clearCheatSearchHistory { --dev-opacity-background: #9c3737; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-paper); --dev-opacity-border-top: var(--rv-brick); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-brick); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-brick); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-brick); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
#deleteMacro:hover, #clearCheatSearchHistory:hover { --dev-opacity-background: #7f2b2b; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-paper); }
.execute-button:disabled, #saveMacro:disabled, #runMacro:disabled, #deleteMacro:disabled, #clearCheatSearchHistory:disabled { --dev-opacity-background: #dfd2c0; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: #887968; --dev-opacity-border-top: #b2a18b; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #b2a18b; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #b2a18b; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #b2a18b; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.cheat-toolbar { --dev-opacity-border-bottom: var(--rv-sand); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); }
.cheat-splitter { --dev-opacity-background: #c7ab89; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.cheat-splitter:hover, .cheat-splitter.dragging { --dev-opacity-background: var(--rv-sepia); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
