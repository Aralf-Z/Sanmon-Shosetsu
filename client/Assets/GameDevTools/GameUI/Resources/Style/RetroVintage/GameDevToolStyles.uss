.search-history-popup { --dev-opacity-background: var(--rv-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: var(--rv-sepia); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-sepia); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-sepia); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-sepia); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.search-history-scroll { --dev-opacity-background: var(--rv-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
Button.search-history-entry { --dev-opacity-background: var(--rv-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--dev-text); border-width: 2px; --dev-opacity-border-top: var(--rv-sand); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-sand); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-sand); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-sand); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); padding: 2px 8px; }
Button.search-history-entry:hover, Button.search-history-entry.search-history-hovered, Button.search-history-entry:focus { --dev-opacity-background: var(--rv-forest); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--rv-paper); --dev-opacity-border-top: var(--rv-forest); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-forest); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-forest); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-forest); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.search-history-empty { color: #765b3c; }

.context-menu { --dev-opacity-background: var(--rv-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--dev-text); }
.context-menu-root .unity-base-dropdown__container-outer { --dev-opacity-background: var(--rv-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-width: 2px; --dev-opacity-border-top: var(--rv-sepia); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--rv-sepia); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--rv-sepia); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--rv-sepia); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 4px; }
.context-menu .unity-base-dropdown__item { --dev-opacity-background: var(--rv-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.context-menu .unity-base-dropdown__item:hover, .context-menu .unity-base-dropdown__item:hover > .unity-base-dropdown__item-content { --dev-opacity-background: var(--rv-forest); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.context-menu .unity-base-dropdown__label { color: var(--dev-text); }
.context-menu .unity-base-dropdown__item:hover .unity-base-dropdown__label { color: var(--rv-paper); }

/* Per-theme floating badge and independent log surface. */

.floating-tool { border-width: 3px; border-radius: 7px; --dev-opacity-border-top: #8b4513; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #8b4513; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #8b4513; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #8b4513; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); --dev-opacity-background: #e0bb85; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-bottom-width: 5px; }
.floating-badge-frame { left: 5px; right: 14px; top: 8px; bottom: 9px; border-width: 2px; border-radius: 3px; --dev-opacity-border-top: #12221a; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #12221a; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #12221a; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #12221a; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); --dev-opacity-background: #1d2b25; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.floating-badge-mark-a { left: 9px; top: auto; bottom: 5px; width: 5px; height: 2px; --dev-opacity-background: #2e4a3f; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.floating-badge-mark-b { left: 17px; bottom: 5px; width: 12px; height: 2px; --dev-opacity-background: #8b4513; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.floating-icon { color: #b7d6a3; margin-right: 8px; font-size: 13px; }
.floating-settings-button { color: #442d21; }
.floating-tool:hover .floating-badge-frame { --dev-opacity-border-top: #d4a373; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #d4a373; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #d4a373; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #d4a373; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.floating-log-preview { --floating-log-background: #1d2b25; border-width: 2px; --dev-opacity-border-top: #b68a58; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #b68a58; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #b68a58; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #b68a58; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-left-width: 4px; border-radius: 5px; }
/* 正文由显式 ScrollView 管理, 输入框按实际文字尺寸撑开. */

.window-header-pattern {
    --header-pattern-image: url("SurfaceTexture.png");
    --header-pattern-width: 128;
    --header-pattern-height: 128;
}

#helpHeader { background-image: none; --dev-opacity-background: var(--dev-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }

.help-navigation {
    --help-hover-background: #ede1cf;
    --help-selected-background: #d3dfcf;
    --help-selected-text: #2e4a3f;
}
