.dev-horizontal-slider:disabled .unity-base-slider__tracker { --dev-opacity-background: var(--dev-border); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.dev-horizontal-slider:disabled .unity-base-slider__dragger { --dev-opacity-background: var(--dev-muted); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }

/* Drafting grid and fine technical rules rather than glow. */
.header, .footer { background-image: url("SurfaceTexture.png"); background-repeat: repeat repeat; background-size: 48px 48px; }
.title { color: #ffffff; }
.settings-section-title { color: #cce3fa; --dev-opacity-border-bottom: #7da5cc; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); }
.settings-section { border-top-width: 2px; --dev-opacity-border-top: #a0c4e8; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); }
.floating-tool { --dev-opacity-background: #1e3a5f; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); background-image: url("SurfaceTexture.png"); background-repeat: repeat repeat; background-size: 48px 48px; }
.floating-badge-frame { left: 7px; right: 7px; top: 8px; bottom: 8px; --dev-opacity-border-top: #cce3fa; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #cce3fa; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #cce3fa; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #cce3fa; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.floating-badge-mark-a { left: 3px; top: 4px; bottom: auto; width: 16px; height: 1px; --dev-opacity-background: #ffffff; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.floating-badge-mark-b { left: auto; right: 3px; bottom: 4px; width: 16px; height: 1px; --dev-opacity-background: #ffffff; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.floating-icon { color: #ffffff; font-size: 13px; }
.floating-log-preview { --dev-opacity-border-top: #7da5cc; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #7da5cc; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #7da5cc; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #7da5cc; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); --dev-opacity-border-left: #ff945f; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
/* 正文由显式 ScrollView 管理, 输入框按实际文字尺寸撑开. */

.window-header-pattern {
    --header-pattern-image: url("SurfaceTexture.png");
    --header-pattern-width: 48;
    --header-pattern-height: 48;
}

#helpHeader { background-image: none; }

.help-navigation {
    --help-hover-background: #2c5077;
    --help-selected-background: #3f668e;
    --help-selected-text: #edf5ff;
}
