.search-history-empty { color: var(--cel-ink); }

.context-menu { --dev-opacity-background: var(--cel-paper); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--cel-ink); }
.context-menu-root .unity-base-dropdown__container-outer { --dev-opacity-background: var(--cel-paper); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-width: 3px; border-right-width: 6px; border-bottom-width: 6px; --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.context-menu .unity-base-dropdown__item { --dev-opacity-background: var(--cel-paper); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.context-menu .unity-base-dropdown__item:hover, .context-menu .unity-base-dropdown__item:hover > .unity-base-dropdown__item-content { --dev-opacity-background: var(--cel-yellow); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.context-menu .unity-base-dropdown__label { color: var(--cel-ink); -unity-font-style: bold; }

/* Per-theme floating badge and independent log surface. */

.floating-tool { border-width: 3px; border-radius: 0; --dev-opacity-background: #f1c40f; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-right-width: 6px; border-bottom-width: 6px; }
.floating-badge-frame { border-width: 0; border-radius: 0; border-top-width: 2px; --dev-opacity-border-top: #1a1a2e; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); top: 9px; left: 7px; right: 18px; bottom: 9px; }
.floating-badge-mark-a { top: auto; bottom: 5px; left: 7px; width: 9px; height: 7px; --dev-opacity-background: #e63946; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.floating-badge-mark-b { left: 18px; bottom: 5px; width: 21px; height: 7px; --dev-opacity-background: #4ea8de; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.floating-icon { color: #1a1a2e; padding-bottom: 5px; }
.floating-log-preview { --floating-log-background: #1a1a2e; border-width: 2px; border-right-width: 4px; border-bottom-width: 4px; --dev-opacity-border-top: #f1c40f; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #f1c40f; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #f1c40f; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #f1c40f; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 0; }
/* 正文由显式 ScrollView 管理, 输入框按实际文字尺寸撑开. */



#helpHeader { background-image: none; }

.help-navigation {
    --help-hover-background: #c9c4b9;
    --help-selected-background: #95bed0;
    --help-selected-text: #1a1a2e;
}
