/* StyleKit Cel Shading adaptation: flat fills, ink contours and solid backplates. */
:root {
    --cel-ink: #1a1a2e;
    --cel-paper: #d4cfc5;
    --cel-surface: #dfdad0;
    --cel-input: #e7e2d8;
    --cel-red: #e63946;
    --cel-blue: #4ea8de;
    --cel-green: #2ecc71;
    --cel-yellow: #f1c40f;
    --dev-background: var(--cel-paper);
    --dev-surface: var(--cel-surface);
    --dev-input: var(--cel-input);
    --dev-border: #1a1a2e;
    --dev-text: #1a1a2e;
    --dev-muted: #4f5062;
    --dev-accent: #4ea8de;
    color: var(--cel-ink);
    -unity-font-style: bold;
}

.dev-window { padding: 0; border-width: 0; border-radius: 0; --dev-opacity-background: transparent; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); overflow: visible; }
.theme-shadow { display: flex; position: absolute; left: 4px; top: 4px; right: -4px; bottom: -4px; --dev-opacity-background: var(--cel-ink); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.theme-window-surface { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; border-width: 3px; --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); --dev-opacity-background: var(--cel-paper); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); overflow: hidden; }
.header { --dev-opacity-background: var(--cel-yellow); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-bottom-width: 3px; --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); }
.title { color: var(--cel-ink); font-size: 20px; -unity-font-style: bold; }
.footer { color: var(--cel-ink); --dev-opacity-background: var(--cel-blue); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-top-width: 3px; --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); }
.section-title, .help-feature-title, .search-history-window-title { color: var(--cel-ink); -unity-font-style: bold; }
.muted, .help-area-title, .help-page-info, .settings-section-hint { color: #4f5062; }

Button { border-width: 3px; --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 0; --dev-opacity-background: var(--cel-blue); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--cel-ink); padding: 3px 10px; -unity-font-style: bold; }
Button:hover { --dev-opacity-background: var(--cel-yellow); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); color: var(--cel-ink); }
Button:active { --dev-opacity-background: var(--cel-green); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); color: var(--cel-ink); translate: 1px 1px; }
Button.selected { --dev-opacity-background: var(--cel-yellow); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); color: var(--cel-ink); }
Button:focus { --dev-opacity-border-top: var(--cel-red); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-red); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-red); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-red); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
Button:disabled { --dev-opacity-background: #e5e3d9; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: #585866; --dev-opacity-border-top: #747482; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #747482; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #747482; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #747482; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
Button.help-button { --dev-opacity-background: var(--cel-yellow); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-width: 2px; padding: 0 2px; }
.side-tab { border-top-right-radius: 0; border-bottom-right-radius: 0; --dev-opacity-background: var(--cel-paper); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.side-tab.selected { --dev-opacity-background: var(--cel-yellow); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }

.unity-base-field__input { --dev-opacity-background: var(--cel-input); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--cel-ink); border-width: 3px; --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 0; padding: 4px 6px; }
.unity-base-text-field__input { --unity-cursor-color: var(--cel-ink); }
.unity-base-field__input:focus { --dev-opacity-border-top: var(--cel-blue); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-blue); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-blue); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-blue); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.unity-base-field__label { color: var(--cel-ink); }
.unity-toggle__input { border-width: 0; --dev-opacity-background: transparent; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.unity-toggle__checkmark { border-width: 3px; --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 0; --dev-opacity-background: var(--cel-input); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.unity-toggle:checked .unity-toggle__checkmark { --dev-opacity-background: var(--cel-green); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.unity-scroller .unity-base-slider__input { border-width: 0; padding: 0; --dev-opacity-background: transparent; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.unity-base-slider__tracker { --dev-opacity-background: #d8e9ef; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-radius: 0; }
.unity-base-slider__dragger { --dev-opacity-background: var(--cel-blue); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-width: 2px; --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 0; }
.unity-base-slider__dragger:hover { --dev-opacity-background: var(--cel-yellow); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.command-list .unity-scroller--vertical, .settings-scroll .unity-scroller--vertical, .macro-source-native-scroll .unity-scroller { --dev-opacity-background: #d8e9ef; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-radius: 0; }
.command-list .unity-scroller--vertical .unity-base-slider__tracker, .settings-scroll .unity-scroller--vertical .unity-base-slider__tracker, .macro-source-native-scroll .unity-base-slider__tracker { --dev-opacity-background: #d8e9ef; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.dev-horizontal-slider > .unity-base-slider__input { border-width: 0; padding: 0; --dev-opacity-background: transparent; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.dev-horizontal-slider .unity-base-slider__tracker { --dev-opacity-background: var(--cel-ink); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-radius: 0; }
.dev-horizontal-slider .unity-base-slider__dragger { --dev-opacity-background: var(--cel-blue); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-width: 2px; --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 0; }
.dev-horizontal-slider:disabled .unity-base-slider__tracker { --dev-opacity-background: #747482; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.dev-horizontal-slider:disabled .unity-base-slider__dragger { --dev-opacity-background: #e5e3d9; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }

.unity-list-view { border-width: 3px; --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); --dev-opacity-background: var(--cel-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.unity-collection-view__item:hover { --dev-opacity-background: #d8effb; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.unity-collection-view__item--selected { --dev-opacity-background: var(--cel-blue); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.command-button { --dev-opacity-background: var(--cel-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); padding: 2px 8px; }
.fixed-macro-entry { border-width: 3px; --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 0; --dev-opacity-background: var(--cel-green); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--cel-ink); }
.fixed-macro-entry:hover { --dev-opacity-background: var(--cel-yellow); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.fixed-macro-entry:active, .fixed-macro-entry.selected { --dev-opacity-background: var(--cel-yellow); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--cel-ink); --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.fixed-macro-entry:focus { --dev-opacity-border-top: var(--cel-red); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-red); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-red); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-red); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.pin-drag-handle { color: var(--cel-ink); }
.pin-drag-handle:hover { --dev-opacity-background: var(--cel-yellow); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--cel-ink); }
.macro-pin-marker { color: var(--cel-ink); }
.preset-button { padding: 2px 4px; border-radius: 0; --dev-opacity-background: var(--cel-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.preset-name { color: var(--cel-ink); }
Button:disabled .preset-name { color: #585866; }
.macro-grid-button { padding: 0 4px; border-width: 2px; }
.execute-button, #saveMacro, #runMacro { --dev-opacity-background: var(--cel-green); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--cel-ink); }
.execute-button:hover, #saveMacro:hover, #runMacro:hover { --dev-opacity-background: var(--cel-yellow); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
#deleteMacro, #clearCheatSearchHistory { --dev-opacity-background: #b91f32; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: #ffffff; }
#deleteMacro:hover, #clearCheatSearchHistory:hover { --dev-opacity-background: var(--cel-yellow); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--cel-ink); }
.execute-button:disabled, #saveMacro:disabled, #runMacro:disabled, #deleteMacro:disabled, #clearCheatSearchHistory:disabled { --dev-opacity-background: #e5e3d9; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: #585866; --dev-opacity-border-top: #747482; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #747482; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #747482; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #747482; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.cheat-toolbar { border-bottom-width: 3px; --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); }
.cheat-splitter { --dev-opacity-background: var(--cel-ink); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }

.command-hover-details { padding: 8px; border-width: 3px; --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 0; --dev-opacity-background: var(--cel-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); overflow: visible; }
.command-hover-details > .theme-shadow { left: 1px; top: 1px; right: -7px; bottom: -7px; --dev-opacity-background: transparent; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-right-width: 4px; border-bottom-width: 4px; --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.pinned-drag-preview { --dev-opacity-background: var(--cel-yellow); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--cel-ink); border-width: 3px; --dev-opacity-border-top: var(--cel-ink); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-ink); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-ink); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-ink); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 0; }
.pinned-drag-preview-icon { --dev-opacity-background: var(--cel-green); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--cel-ink); border-radius: 0; }
.pinned-drag-preview-name { color: var(--cel-ink); }
.resize-preview { border-width: 3px; --dev-opacity-border-top: var(--cel-red); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--cel-red); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--cel-red); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--cel-red); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 0; }
