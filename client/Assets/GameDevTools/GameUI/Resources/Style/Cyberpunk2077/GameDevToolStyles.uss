:root {
    --cp-red: #ff5a6b;
    --cp-cyan: #69f2ed;
    --cp-yellow: #fcee0a;
    --cp-border: #73313f;
    --dev-background: #0d0e17;
    --dev-surface: #18121d;
    --dev-input: #080c14;
    --dev-border: #73313f;
    --dev-text: #f1d5d8;
    --dev-muted: #a7808c;
    --dev-accent: #1d3038;
    --theme-accent: #69f2ed;
    --theme-screen: #080c14;
    color: var(--dev-text);
}

.dev-window {
    border-width: 1px;
    border-radius: 0px;
    --dev-opacity-background: var(--dev-background);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    --dev-opacity-border-top: var(--dev-border);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--dev-border);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--dev-border);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--dev-border);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
}

.header {
    --dev-opacity-background: var(--dev-surface);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    border-bottom-width: 1px;
    --dev-opacity-border-bottom: var(--theme-accent);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
}

.title {
    color: var(--theme-accent);
    -unity-font-style: bold;
}

.footer {
    --dev-opacity-background: var(--dev-input);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    color: var(--dev-muted);
    border-top-width: 1px;
    --dev-opacity-border-top: var(--dev-border);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
}

.section-title, .settings-section-title, .help-feature-title {
    color: var(--dev-text);
}

.muted, .help-area-title, .help-page-info, .settings-section-hint {
    color: var(--dev-muted);
}

Button {
    --dev-opacity-background: var(--dev-surface);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    color: var(--dev-text);
    border-width: 1px;
    --dev-opacity-border-top: var(--dev-border);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--dev-border);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--dev-border);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--dev-border);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
    border-radius: 0px;
}

Button:hover {
    --dev-opacity-background: var(--dev-accent);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    --dev-opacity-border-top: var(--theme-accent);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--theme-accent);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--theme-accent);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--theme-accent);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
    color: var(--dev-text);
}

Button:active, Button.selected {
    --dev-opacity-background: var(--dev-accent);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    color: var(--dev-text);
    --dev-opacity-border-top: var(--theme-accent);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--theme-accent);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--theme-accent);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--theme-accent);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
}

Button:focus {
    --dev-opacity-border-top: var(--theme-accent);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--theme-accent);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--theme-accent);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--theme-accent);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
}

Button:disabled {
    --dev-opacity-background: var(--dev-input);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    color: var(--dev-muted);
    --dev-opacity-border-top: var(--dev-border);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--dev-border);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--dev-border);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--dev-border);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
    --dev-opacity-local: .65;
    opacity: var(--dev-opacity-local);
}

Button.help-button {
    --dev-opacity-background: transparent;
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    border-width: 1px;
}

.side-tab {
    border-radius: 0px;
    --dev-opacity-background: var(--dev-input);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    color: var(--dev-muted);
}

.side-tab.selected {
    --dev-opacity-background: var(--dev-surface);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    color: var(--theme-accent);
    border-left-width: 3px;
    --dev-opacity-border-left: var(--theme-accent);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
}

.unity-base-field__input {
    --dev-opacity-background: var(--dev-input);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    color: var(--dev-text);
    border-width: 1px;
    --dev-opacity-border-top: var(--dev-border);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--dev-border);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--dev-border);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--dev-border);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
    border-radius: 0px;
}

.unity-base-field__label {
    color: var(--dev-text);
}

.unity-base-text-field__input {
    --unity-cursor-color: var(--dev-text);
    --unity-selection-color: var(--dev-accent);
}

.unity-base-field__input:focus {
    --dev-opacity-border-top: var(--theme-accent);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--theme-accent);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--theme-accent);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--theme-accent);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
}

.unity-toggle__input {
    --dev-opacity-background: transparent;
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    border-width: 0;
}

.unity-toggle__checkmark {
    --dev-opacity-background: var(--dev-input);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    border-width: 1px;
    --dev-opacity-border-top: var(--dev-border);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--dev-border);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--dev-border);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--dev-border);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
    border-radius: 0px;
}

.unity-toggle:checked .unity-toggle__checkmark {
    --dev-opacity-background: var(--theme-accent);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    --dev-opacity-border-top: var(--theme-accent);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--theme-accent);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--theme-accent);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--theme-accent);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
}

.unity-scroller .unity-base-slider__input, .dev-horizontal-slider > .unity-base-slider__input {
    --dev-opacity-background: transparent;
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    border-width: 0;
    padding: 0;
}

.unity-base-slider__tracker, .dev-horizontal-slider .unity-base-slider__tracker {
    --dev-opacity-background: var(--dev-border);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    border-radius: 0px;
}

.unity-base-slider__dragger, .dev-horizontal-slider .unity-base-slider__dragger {
    --dev-opacity-background: var(--theme-accent);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    border-width: 1px;
    --dev-opacity-border-top: var(--dev-border);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--dev-border);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--dev-border);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--dev-border);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
    border-radius: 0px;
}

.unity-base-slider__dragger:hover {
    --dev-opacity-background: var(--dev-text);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
}

.command-list .unity-scroller--vertical, .settings-scroll .unity-scroller--vertical, .macro-source-native-scroll .unity-scroller {
    --dev-opacity-background: var(--dev-input);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    border-radius: 0px;
}

.command-list .unity-base-slider__tracker, .settings-scroll .unity-base-slider__tracker, .macro-source-native-scroll .unity-base-slider__tracker {
    --dev-opacity-background: var(--dev-border);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
}

.unity-list-view {
    border-width: 1px;
    --dev-opacity-border-top: var(--dev-border);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--dev-border);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--dev-border);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--dev-border);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
    --dev-opacity-background: var(--dev-input);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
}

.unity-collection-view__item:hover, .unity-collection-view__item--selected {
    --dev-opacity-background: var(--dev-accent);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
}

.command-button, .preset-button, .macro-grid-button {
    --dev-opacity-background: var(--dev-surface);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    border-radius: 0px;
}

.preset-name {
    color: var(--dev-text);
}

.fixed-macro-entry {
    border-width: 1px;
    --dev-opacity-border-top: var(--theme-accent);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--theme-accent);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--theme-accent);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--theme-accent);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
    --dev-opacity-background: var(--dev-accent);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    color: var(--dev-text);
    border-radius: 0px;
}

.fixed-macro-entry:hover, .fixed-macro-entry.selected {
    --dev-opacity-border-top: var(--dev-text);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--dev-text);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--dev-text);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--dev-text);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
    --dev-opacity-background: var(--dev-accent);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    color: var(--dev-text);
}

.pin-drag-handle, .macro-pin-marker {
    color: var(--theme-accent);
}

.pin-drag-handle:hover {
    --dev-opacity-background: var(--dev-accent);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
}

.execute-button, #saveMacro, #runMacro {
    --dev-opacity-border-top: var(--theme-accent);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--theme-accent);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--theme-accent);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--theme-accent);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
    --dev-opacity-background: var(--dev-accent);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    color: var(--dev-text);
}

.execute-button:hover, #saveMacro:hover, #runMacro:hover {
    --dev-opacity-border-top: var(--dev-text);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--dev-text);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--dev-text);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--dev-text);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
}

.cheat-toolbar {
    --dev-opacity-border-bottom: var(--dev-border);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
}

.cheat-splitter {
    --dev-opacity-background: var(--dev-border);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
}

.command-hover-details, .floating-settings {
    --dev-opacity-background: var(--dev-surface);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    --dev-opacity-border-top: var(--dev-border);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--dev-border);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--dev-border);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--dev-border);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
    border-width: 1px;
    border-radius: 0px;
}

.pinned-drag-preview {
    --dev-opacity-background: var(--dev-surface);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    --dev-opacity-border-top: var(--theme-accent);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--theme-accent);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--theme-accent);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--theme-accent);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
    color: var(--dev-text);
    border-radius: 0px;
}

.pinned-drag-preview-icon {
    --dev-opacity-background: var(--dev-accent);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    color: var(--dev-text);
}

.pinned-drag-preview-name {
    color: var(--dev-text);
}

.resize-preview {
    --dev-opacity-border-top: var(--theme-accent);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--theme-accent);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--theme-accent);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--theme-accent);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
    border-radius: 0px;
}

.resize-handle {
    color: var(--theme-accent);
}

.drop-top, .drop-bottom, .drop-left, .drop-right {
    --dev-opacity-border-top: var(--theme-accent);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--theme-accent);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--theme-accent);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--theme-accent);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
}

.output-list, .suggestion-list {
    --dev-opacity-background: var(--theme-screen);
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    color: #f1d5d8;
    border-width: 1px;
    --dev-opacity-border-top: var(--dev-border);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
    --dev-opacity-border-right: var(--dev-border);
    --dev-opacity-border-right-set: 1;
    border-right-color: var(--dev-opacity-border-right);
    --dev-opacity-border-bottom: var(--dev-border);
    --dev-opacity-border-bottom-set: 1;
    border-bottom-color: var(--dev-opacity-border-bottom);
    --dev-opacity-border-left: var(--dev-border);
    --dev-opacity-border-left-set: 1;
    border-left-color: var(--dev-opacity-border-left);
    border-radius: 0px;
}

.console-log-row:hover {
    --dev-opacity-background: #21131e;
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
}

.console-log-row.selected, .suggestion-selected, .suggestion-list .unity-collection-view__item--selected {
    --dev-opacity-background: #19323a;
