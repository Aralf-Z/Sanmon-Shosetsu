    --dev-opacity-border-bottom: var(--cp-red);
}

.title {
    color: var(--cp-yellow);
    -unity-font-style: bold;
}

.window-header-pattern {
    --header-pattern-image: url("InterfacePattern.png");
    --header-pattern-width: 256;
    --header-pattern-height: 48;
    --header-pattern-fade: 48;
}

.footer {
    --dev-opacity-background: transparent;
    background-color: var(--dev-opacity-background);
    --dev-opacity-border-top: var(--cp-border);
    color: var(--cp-red);
}

.toolkit-version {
    color: var(--cp-cyan);
}

.side-tab {
    --dev-opacity-background: #170f18;
    color: var(--cp-red);
    border-left-width: 3px;
}

.side-tab.selected, .side-tab.selected:hover {
    --dev-opacity-background: var(--cp-red);
    --dev-opacity-border-left: var(--cp-cyan);
    --dev-opacity-border-right: var(--cp-red);
    --dev-opacity-border-top: var(--cp-red);
    --dev-opacity-border-bottom: var(--cp-red);
    color: #080c14;
    -unity-font-style: bold;
}

.section-title, .settings-section-title, .help-feature-title, .help-title {
    color: var(--cp-cyan);
}

.settings-section-title {
    --dev-opacity-border-bottom: var(--cp-border);
}

.settings-section {
    border-top-width: 2px;
    --dev-opacity-border-top: var(--cp-red);
    --dev-opacity-border-top-set: 1;
    border-top-color: var(--dev-opacity-border-top);
}

Button {
    color: var(--cp-red);
}

Button:hover, Button:focus {
    --dev-opacity-background: #2b1722;
    --dev-opacity-border-top: var(--cp-red);
    --dev-opacity-border-right: var(--cp-red);
    --dev-opacity-border-bottom: var(--cp-red);
    --dev-opacity-border-left: var(--cp-red);
    color: #ffd7da;
}

Button:active, Button.selected, Button.selected:hover, Button.command-button-selected, Button.search-history-hovered, Button.help-tree-entry.selected {
    --dev-opacity-background: #123039;
    --dev-opacity-border-top: var(--cp-cyan);
    --dev-opacity-border-right: var(--cp-cyan);
    --dev-opacity-border-bottom: var(--cp-cyan);
    --dev-opacity-border-left: var(--cp-cyan);
    color: var(--cp-cyan);
}

.command-button, .preset-button, .macro-grid-button, .macro-library-button {
    color: var(--dev-text);
}

.fixed-macro-entry {
    --dev-opacity-background: #2b2418;
    --dev-opacity-border-top: var(--cp-yellow);
    --dev-opacity-border-right: var(--cp-yellow);
    --dev-opacity-border-bottom: var(--cp-yellow);
    --dev-opacity-border-left: var(--cp-yellow);
    color: var(--cp-yellow);
}

.unity-base-field__label, .macro-library .unity-toggle__text {
    color: var(--cp-red);
}

.unity-base-field__input:focus {
    --dev-opacity-border-top: var(--cp-cyan);
    --dev-opacity-border-right: var(--cp-cyan);
    --dev-opacity-border-bottom: var(--cp-cyan);
    --dev-opacity-border-left: var(--cp-cyan);
}

.unity-base-slider__tracker, .dev-horizontal-slider .unity-base-slider__tracker {
    --dev-opacity-background: #61303d;
}

.unity-base-slider__dragger, .dev-horizontal-slider .unity-base-slider__dragger {
    --dev-opacity-background: var(--cp-cyan);
    --dev-opacity-border-top: var(--cp-cyan);
    --dev-opacity-border-right: var(--cp-cyan);
    --dev-opacity-border-bottom: var(--cp-cyan);
    --dev-opacity-border-left: var(--cp-cyan);
}

.unity-toggle:checked .unity-toggle__checkmark {
    --dev-opacity-background: var(--cp-cyan);
    --dev-opacity-border-top: var(--cp-cyan);
    --dev-opacity-border-right: var(--cp-cyan);
    --dev-opacity-border-bottom: var(--cp-cyan);
    --dev-opacity-border-left: var(--cp-cyan);
}

.console-stack-entry-selected, .unity-collection-view__item--selected {
    --dev-opacity-background: #19323a;
}

.console-stack-entry:hover, .unity-collection-view__item:hover {
    --dev-opacity-background: #2b1722;
}

.macro-keyword.selected {
    --dev-opacity-background: #123039;
    color: var(--cp-cyan);
}

.macro-help-example, .macro-line-numbers {
    color: var(--cp-cyan);
}

.help-dialog, .search-history-dialog {
    --dev-opacity-background: transparent;
    background-color: var(--dev-opacity-background);
    border-width: 0;
    padding: 0;
}

.help-navigation {
    --help-hover-background: #2b1722;
    --help-selected-background: #123039;
    --help-selected-text: #69f2ed;
}

.context-menu-root .unity-base-dropdown__container-outer, .search-history-popup, .tag-overflow-popup {
    --dev-opacity-border-top: var(--cp-red);
    --dev-opacity-border-right: var(--cp-red);
    --dev-opacity-border-bottom: var(--cp-red);
    --dev-opacity-border-left: var(--cp-red);
}

.context-menu .unity-base-dropdown__label {
    color: var(--cp-red);
}

.floating-tool {
    --dev-opacity-background: #10101b;
    --dev-opacity-border-top: var(--cp-red);
    --dev-opacity-border-right: var(--cp-red);
    --dev-opacity-border-bottom: var(--cp-red);
    --dev-opacity-border-left: var(--cp-red);
    border-left-width: 3px;
}

.floating-badge-frame {
    border-radius: 0;
    --dev-opacity-border-top: var(--cp-red);
    --dev-opacity-border-right: var(--cp-red);
    --dev-opacity-border-bottom: var(--cp-red);
    --dev-opacity-border-left: var(--cp-red);
}

.floating-badge-mark-a, .floating-badge-mark-b {
    --dev-opacity-background: var(--cp-cyan);
}

.floating-icon {
    color: var(--cp-yellow);
}

.floating-log-preview {
    --floating-log-background: #080c14;
    --dev-opacity-border-left: var(--cp-cyan);
}

.resize-handle:hover {
    --dev-opacity-background: #123039;
}
