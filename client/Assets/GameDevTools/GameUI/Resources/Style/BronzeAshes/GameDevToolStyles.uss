    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
}
.unity-toggle__checkmark { --dev-opacity-background: var(--dev-input); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-width: 1px; --dev-opacity-border-top: var(--dev-border); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--dev-border); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--dev-border); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--dev-border); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 0px; }
.unity-toggle:checked .unity-toggle__checkmark { --dev-opacity-background: var(--theme-accent); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: var(--theme-accent); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--theme-accent); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--theme-accent); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--theme-accent); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
