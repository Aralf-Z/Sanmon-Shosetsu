Button.search-history-entry { --dev-opacity-background: #173034; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: #e8e5d4; }
Button.search-history-entry:hover, Button.search-history-entry.search-history-hovered, Button.search-history-entry:focus { --dev-opacity-background: #28535b; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: #ddc47d; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #ddc47d; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #ddc47d; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #ddc47d; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); color: #f5e5b8; }
.context-menu-root .unity-base-dropdown__container-outer { --dev-opacity-background: #173034; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-width: 2px; --dev-opacity-border-top: #a59052; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #a59052; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #a59052; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #a59052; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 1px; }
.context-menu .unity-base-dropdown__item { --dev-opacity-background: #173034; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.context-menu .unity-base-dropdown__item:hover, .context-menu .unity-base-dropdown__item:hover > .unity-base-dropdown__item-content { --dev-opacity-background: #28535b; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
.context-menu .unity-base-dropdown__label { color: #e8e5d4; }

/* Sacred bird bronze ring: transparent silhouette, existing rectangular hit area. */
.floating-tool, .floating-tool:hover, .floating-tool.docked {
    --dev-opacity-background: transparent;
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    background-image: none;
    border-width: 0;
    border-radius: 0;
}
.floating-badge-frame {
    left: 2px;
    top: 0;
    right: auto;
    bottom: auto;
    width: 56px;
    height: 56px;
    border-width: 0;
    border-radius: 0;
    rotate: 0deg;
    background-image: url("FloatingBadge.png");
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center center;
    --dev-opacity-image-tint: #e7e1ca;
    --dev-opacity-image-tint-set: 1;
    -unity-background-image-tint-color: var(--dev-opacity-image-tint);
}
.floating-tool:hover .floating-badge-frame { --dev-opacity-image-tint: #fff3d4; }
.floating-tool.docked .floating-badge-frame { --dev-opacity-image-tint: #f5e7b8; }
.floating-badge-mark-a, .floating-badge-mark-b, .floating-badge-prefix, .floating-icon { display: none; }
.floating-tool > Button.floating-settings-button {
    right: 0;
    top: 0;
    width: 18px;
    height: 18px;
    border-width: 0;
    border-radius: 9px;
    --dev-opacity-background: transparent;
    --dev-opacity-background-set: 1;
    background-color: var(--dev-opacity-background);
    color: #ddc47d;
}
.floating-tool > Button.floating-settings-button:hover {
    --dev-opacity-background: #193c36;
    color: #f5e5b8;
}
.floating-log-preview { --floating-log-background: #0e2528; border-width: 1px; --dev-opacity-border-top: #887744; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #887744; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #887744; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #887744; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-left-width: 3px; --dev-opacity-border-left: #b59a56; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 2px; padding: 7px; }
/* 正文由显式 ScrollView 管理, 输入框按实际文字尺寸撑开. */

.window-header-pattern {
    --header-pattern-image: url("HeaderPattern.png");
    --header-pattern-width: 160;
    --header-pattern-height: 64;
}

#helpHeader { background-image: none; }

.help-navigation {
    --help-hover-background: #24413f;
    --help-selected-background: #315c58;
    --help-selected-text: #f5e5b8;
}
