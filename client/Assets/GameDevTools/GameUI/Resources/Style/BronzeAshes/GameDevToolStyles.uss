/* Layered bronze frame: ornamental backplate is non-interactive and does not affect layout. */
.dev-window { padding: 4px; border-width: 2px; --dev-opacity-border-top: #887744; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #887744; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #887744; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #887744; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 2px; --dev-opacity-background: #102326; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); overflow: visible; }
.theme-shadow { display: flex; position: absolute; left: -7px; right: -7px; top: -7px; bottom: -7px; --dev-opacity-background: transparent; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); background-image: url("WindowFrame.png"); -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 24; -unity-slice-bottom: 24; }
