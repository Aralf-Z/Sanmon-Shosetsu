.help-body { color: #e8e5d4; }
.search-history-record { --dev-opacity-background: #193236; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-bottom: #536e64; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); }
.search-history-popup { --dev-opacity-background: #173034; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-width: 2px; --dev-opacity-border-top: #a59052; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #a59052; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #a59052; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #a59052; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
