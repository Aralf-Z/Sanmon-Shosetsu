/* Restrained cloud engraving is confined to headings, leaving body copy on quiet surfaces. */
.settings-section { --dev-opacity-background: #193236; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: #536e64; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #536e64; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #536e64; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #536e64; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); --dev-opacity-border-top: #a59052; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); border-left-width: 3px; --dev-opacity-border-left: #887744; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); padding: 12px; }
.settings-section-title { --dev-opacity-border-bottom: #887744; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); color: #ddc47d; }
.help-dialog, .search-history-dialog, .floating-settings { --dev-opacity-background: #173034; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-width: 2px; --dev-opacity-border-top: #a59052; --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: #a59052; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: #a59052; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: #a59052; --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 2px; }
.help-header, .search-history-window-header { --dev-opacity-background: #193236; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); background-image: none; --dev-opacity-border-bottom: #887744; --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); }
.search-history-window-header { background-image: url("HeaderPattern.png"); background-repeat: repeat repeat; background-size: 160px 64px; }
.help-navigation { --dev-opacity-border-right: #685c36; --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); }
.help-navigation .unity-scroller--vertical { --dev-opacity-background: #142c2f; --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); }
