/* Bronze Ashes: screenshot-inspired ink stone, oxidized bronze, gilt rules and cinnabar.
   Palette roles: ground #102326, surface #1b3538, jade #76d6b3, gold #ddc47d,
   aged bronze #887744, bone #e8e5d4, muted sage #adb9aa, cinnabar #8e4234.
   Keep Schema fonts and all live-switchable control structure unchanged. */
:root {
 --dev-background: #102326; --dev-surface: #1b3538; --dev-input: #0e2024;
 --dev-border: #887744; --dev-text: #e8e5d4; --dev-muted: #adb9aa; --dev-accent: #285557;
 --theme-accent: #ddc47d; --theme-screen: #0a191d;
 color: var(--dev-text);
}
.dev-window { border-width: 1px; border-radius: 0px; --dev-opacity-background: var(--dev-background); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: var(--dev-border); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--dev-border); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--dev-border); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--dev-border); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
.header { --dev-opacity-background: var(--dev-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); border-bottom-width: 1px; --dev-opacity-border-bottom: var(--theme-accent); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); }
.title { color: var(--theme-accent); -unity-font-style: bold; }
.footer { --dev-opacity-background: var(--dev-input); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--dev-muted); border-top-width: 1px; --dev-opacity-border-top: var(--dev-border); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); }
.section-title, .settings-section-title, .help-feature-title { color: var(--dev-text); }
.muted, .help-area-title, .help-page-info, .settings-section-hint { color: var(--dev-muted); }
Button { --dev-opacity-background: var(--dev-surface); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--dev-text); border-width: 1px; --dev-opacity-border-top: var(--dev-border); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--dev-border); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--dev-border); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--dev-border); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); border-radius: 0px; }
Button:hover { --dev-opacity-background: var(--dev-accent); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); --dev-opacity-border-top: var(--theme-accent); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--theme-accent); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--theme-accent); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--theme-accent); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); color: var(--dev-text); }
Button:active, Button.selected { --dev-opacity-background: var(--dev-accent); --dev-opacity-background-set: 1; background-color: var(--dev-opacity-background); color: var(--dev-text); --dev-opacity-border-top: var(--theme-accent); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--theme-accent); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--theme-accent); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--theme-accent); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
Button:focus { --dev-opacity-border-top: var(--theme-accent); --dev-opacity-border-top-set: 1; border-top-color: var(--dev-opacity-border-top); --dev-opacity-border-right: var(--theme-accent); --dev-opacity-border-right-set: 1; border-right-color: var(--dev-opacity-border-right); --dev-opacity-border-bottom: var(--theme-accent); --dev-opacity-border-bottom-set: 1; border-bottom-color: var(--dev-opacity-border-bottom); --dev-opacity-border-left: var(--theme-accent); --dev-opacity-border-left-set: 1; border-left-color: var(--dev-opacity-border-left); }
